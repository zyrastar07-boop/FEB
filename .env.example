# FEB / mela — environment template.
#
# Copy to `.env` (gitignored) or pass each via `--dart-define` at build time.
# Never commit real values for any of these.

# Primary Cloudflare Worker URL. Default is phonofilm-proxy.
PROXY_PRIMARY_URL=https://phonofilm-proxy.mela-media-2026.workers.dev

# Comma-separated mirror list for the Worker endpoint pool. Optional.
PROXY_MIRRORS=

# Google OAuth Web Client ID (used by AuthService for sign_in_with_google).
# Must match the Firebase project's web OAuth client (see Google Cloud Console).
GOOGLE_WEB_CLIENT_ID=

# Verify.et API key (Ethiopian payment verification).
# Recommended: run this on a thin server proxy instead of shipping to clients.
VERIFY_ET_API_KEY=

# Patreon creator access token (Patreon API verification, optional).
PATREON_CREATOR_TOKEN=

# Custom Patreon verification backend (preferred over the direct API).
PATREON_VERIFY_URL=

# Patreon membership join URL.
PATREON_URL=https://www.patreon.com/16592174/join

# Cloudflare Turnstile site key (shown to clients before signup / password reset).
# Server-side verification keys live in the Worker repo.
TURNSTILE_SITE_KEY=
